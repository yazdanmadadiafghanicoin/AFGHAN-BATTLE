
<!DOCTYPE html>
<html lang="fa">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>AFGHAN BATTLE</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;background:#111;font-family:Arial;color:white;touch-action:none}
#hud{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between;pointer-events:none}
.panel{background:#111b;padding:10px 14px;border:1px solid #ffffff55;border-radius:10px}
#health{color:#43ff75}
#controls{position:absolute;bottom:25px;left:20px;right:20px;display:flex;justify-content:space-between;align-items:end}
#joy{width:125px;height:125px;border-radius:50%;background:#ffffff22;border:2px solid #ffffff77;position:relative;touch-action:none}
#stick{position:absolute;width:48px;height:48px;left:36px;top:36px;border-radius:50%;background:#ddd9}
#fire{width:85px;height:85px;border-radius:50%;background:#b51f16;border:3px solid white;color:white;font-size:18px;font-weight:bold}
#message{position:absolute;top:42%;width:100%;text-align:center;font-size:28px;font-weight:bold;pointer-events:none;text-shadow:0 2px 5px black}
#restart{display:none;position:absolute;top:55%;left:50%;transform:translateX(-50%);padding:14px 25px;background:#e5a500;border:0;border-radius:10px;font-size:18px}
</style>
</head>
<body>

<div id="hud">
 <div class="panel">
  <b>AFGHAN BATTLE</b><br>
  <span id="health">❤️ 100</span>
 </div>
 <div class="panel">
  دشمنان: <span id="kills">0</span><br>
  مهمات: <span id="ammo">30</span>
 </div>
</div>

<div id="message">AFGHAN BATTLE</div>
<button id="restart" onclick="location.reload()">شروع دوباره</button>

<div id="controls">
 <div id="joy"><div id="stick"></div></div>
 <button id="fire">FIRE</button>
</div>

<script type="module">
import * as THREE from
'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x91b8d0);
scene.fog = new THREE.Fog(0x91b8d0,35,150);

const camera = new THREE.PerspectiveCamera(
 65,innerWidth/innerHeight,0.1,300
);

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
renderer.shadowMap.enabled=true;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffffff,0x657044,2));

const sun = new THREE.DirectionalLight(0xffffff,2);
sun.position.set(-30,60,30);
sun.castShadow=true;
scene.add(sun);

// زمین
const ground = new THREE.Mesh(
 new THREE.PlaneGeometry(300,300),
 new THREE.MeshStandardMaterial({color:0x788451})
);
ground.rotation.x=-Math.PI/2;
ground.receiveShadow=true;
scene.add(ground);

// ساخت محیط
function box(x,y,z,sx,sy,sz,color){
 const m=new THREE.Mesh(
  new THREE.BoxGeometry(sx,sy,sz),
  new THREE.MeshStandardMaterial({color})
 );
 m.position.set(x,y,z);
 m.castShadow=true;
 m.receiveShadow=true;
 scene.add(m);
 return m;
}

// ساختمان‌ها
for(let i=0;i<18;i++){
 let x=(Math.random()-.5)*110;
 let z=(Math.random()-.5)*110;
 if(Math.abs(x)<12 && Math.abs(z)<12)continue;
 box(x,2,z,7,4,7,0xb4a184);
 box(x,4.2,z,7.3,.5,7.3,0x66523c);
}

// درخت‌ها
for(let i=0;i<100;i++){
 let x=(Math.random()-.5)*140;
 let z=(Math.random()-.5)*140;
 if(Math.abs(x)<15 && Math.abs(z)<15)continue;
 box(x,1,z,.7,2,.7,0x65452b);
 const tree=new THREE.Mesh(
  new THREE.ConeGeometry(2.5,6,6),
  new THREE.MeshStandardMaterial({color:0x315b32})
 );
 tree.position.set(x,4,z);
 scene.add(tree);
}

// بازیکن
const player=new THREE.Group();
const body=new THREE.Mesh(
 new THREE.CapsuleGeometry(.55,1.1,4,8),
 new THREE.MeshStandardMaterial({color:0x263d2b})
);
body.position.y=1;
player.add(body);

const head=new THREE.Mesh(
 new THREE.SphereGeometry(.32,12,12),
 new THREE.MeshStandardMaterial({color:0xc99a72})
);
head.position.y=2;
player.add(head);

const gun=box(0,1.25,-.9,.18,.18,1.3,0x222222);
player.add(gun);
scene.add(player);
player.position.set(0,0,0);

// دشمنان
const enemies=[];
function makeEnemy(){
 const e=new THREE.Group();
 const b=new THREE.Mesh(
  new THREE.CapsuleGeometry(.55,1.1,4,8),
  new THREE.MeshStandardMaterial({color:0x9c2420})
 );
 b.position.y=1;
 e.add(b);
 const h=new THREE.Mesh(
  new THREE.SphereGeometry(.3,12,12),
  new THREE.MeshStandardMaterial({color:0xb98768})
 );
 h.position.y=2;
 e.add(h);
 e.position.set(
  (Math.random()-.5)*90,
  0,
  (Math.random()-.5)*90
 );
 scene.add(e);
 enemies.push(e);
}
for(let i=0;i<10;i++)makeEnemy();

// وضعیت بازی
let health=100;
let ammo=30;
let kills=0;
let dead=false;
let moveX=0,moveY=0;
let lastShot=0;

const joy=document.getElementById('joy');
const stick=document.getElementById('stick');
const fire=document.getElementById('fire');

function moveStick(e){
 const r=joy.getBoundingClientRect();
 const dx=e.clientX-(r.left+r.width/2);
 const dy=e.clientY-(r.top+r.height/2);
 const d=Math.min(43,Math.hypot(dx,dy));
 const a=Math.atan2(dy,dx);
 moveX=Math.cos(a)*d/43;
 moveY=Math.sin(a)*d/43;
 stick.style.left=(36+moveX*43)+'px';
 stick.style.top=(36+moveY*43)+'px';
}

joy.addEventListener('pointerdown',e=>{
 joy.setPointerCapture(e.pointerId);
 moveStick(e);
});
joy.addEventListener('pointermove',e=>{
 if(e.buttons)moveStick(e);
});
function resetStick(){
 moveX=0;moveY=0;
 stick.style.left='36px';
 stick.style.top='36px';
}
joy.addEventListener('pointerup',resetStick);
joy.addEventListener('pointercancel',resetStick);

// تیراندازی
const raycaster=new THREE.Raycaster();
function shoot(){
 if(dead || ammo<=0)return;
 const now=performance.now();
 if(now-lastShot<300)return;
 lastShot=now;
 ammo--;
 document.getElementById('ammo').textContent=ammo;

 raycaster.setFromCamera(new THREE.Vector2(0,0),camera);
 const targets=enemies.flatMap(e=>e.children);
 const hits=raycaster.intersectObjects(targets,false);

 if(hits.length){
  const enemy=enemies.find(e=>e.children.includes(hits[0].object));
  if(enemy){
   scene.remove(enemy);
   enemies.splice(enemies.indexOf(enemy),1);
   kills++;
   document.getElementById('kills').textContent=kills;
   if(enemies.length<10 && kills<30)makeEnemy();
  }
 }
}
fire.addEventListener('pointerdown',shoot);

// حلقه بازی
const clock=new THREE.Clock();
const forward=new THREE.Vector3();

function endGame(){
 dead=true;
 document.getElementById('message').textContent='GAME OVER';
 document.getElementById('restart').style.display='block';
}

function animate(){
 requestAnimationFrame(animate);
 const dt=Math.min(clock.getDelta(),.05);

 if(!dead){
  // حرکت بازیکن
  const speed=8;
  const dx=moveX*speed*dt;
  const dz=moveY*speed*dt;
  player.position.x+=dx;
  player.position.z+=dz;

  if(Math.abs(moveX)+Math.abs(moveY)>.1){
   player.rotation.y=Math.atan2(-moveX,-moveY);
  }

  player.position.x=THREE.MathUtils.clamp(player.position.x,-140,140);
  player.position.z=THREE.MathUtils.clamp(player.position.z,-140,140);

  // حرکت دشمنان
  for(const e of enemies){
   const v=new THREE.Vector3().subVectors(
    player.position,e.position
   );
   const dist=v.length();
   if(dist>1.5){
    v.normalize();
    e.position.addScaledVector(v,2.2*dt);
    e.rotation.y=Math.atan2(-v.x,-v.z);
   }else{
    health-=8*dt;
    health=Math.max(0,health);
    document.getElementById('health').textContent=
      '❤️ '+Math.floor(health);
    if(health<=0)endGame();
   }
  }
 }

 // دوربین سوم شخص
 const offset=new THREE.Vector3(0,5,9);
 offset.applyAxisAngle(
  new THREE.Vector3(0,1,0),player.rotation.y
 );
 camera.position.lerp(
  player.position.clone().add(offset),.12
 );
 camera.lookAt(
  player.position.x,player.position.y+1.5,
  player.position.z
 );

 renderer.render(scene,camera);
}

animate();

addEventListener('resize',()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
